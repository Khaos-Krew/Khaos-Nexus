FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NEXUS_GAME_ROLE=minecraft
ENV NEXUS_DATA_DIR=/app/data

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src ./src
COPY config ./config
COPY native ./native
COPY config.example.json ./config.example.json
COPY docs/ops/NEXUS_CRAFT.md ./docs/ops/NEXUS_CRAFT.md

CMD ["node", "src/railway/craft-service.cjs"]
