# Dedicated ARN bot / Railway service
# Copy these names into Railway Variables for the ARN service. Never commit real values.

# Safe default during migration. Use active only after shadow verification and cutover.
ARN_MODE=shadow
ARN_CUTOVER_READY=false

# Discord application created specifically for ARN
ARN_DISCORD_TOKEN=
ARN_DISCORD_APPLICATION_ID=
ARN_DISCORD_CLIENT_ID=
ARN_DISCORD_GUILD_ID=

# Existing Khaos Nexus Discord channels
ARN_PUBLIC_CHANNEL_ID=
ARN_INGEST_CHANNEL_ID=

# Poll/reconcile cadence. 30 seconds matches the intended listener-independent ARN worker cadence.
ARN_RECONCILE_INTERVAL_MS=30000

# Shared persistence. ARN_DATABASE_URL falls back to DATABASE_URL when omitted.
ARN_DATABASE_URL=

# Future privileged action/reward handoff to Nexus Sentinal.
# ARN does not receive broad RCON credentials.
ARN_SENTINAL_JOB_ENDPOINT=
ARN_SENTINAL_JOB_SECRET=

# Optional one-time cutover cleanup. Leave false until Sentinal ARN board ownership is disabled.
ARN_CLEANUP_SENTINAL_PANELS=false
