DISCORD_BOT_TOKEN=

# One-shot hidden intake channel provisioning.
DISCORD_GUILD_ID=
ARN_HIDDEN_CATEGORY_ID=
ARN_HIDDEN_CATEGORY_NAME=
ARN_INGEST_CHANNEL_NAME=arn-ingest

# Runtime channels.
ARN_INGEST_CHANNEL_ID=
ARN_OUTPUT_CHANNEL_ID=

# Preferred routing: one incoming Discord webhook per ARK map, named exactly
# ARN - [mapname]. Sentinel can discover the webhook IDs from the hidden intake
# channel and then treats those IDs as the authoritative runtime map identity.
ARN_AUTO_DISCOVER_WEBHOOKS=true

# Optional explicit webhook-ID mappings. These take precedence over a discovered
# webhook name and are useful if you want to pin identities in Railway.
GEN1_SHINY_WEBHOOK_ID=
ASTRAEOS_SHINY_WEBHOOK_ID=

# Optional scalable mapping for future maps. Keys are Discord webhook IDs.
# Example: {"123456789":"Genesis 1","987654321":"Astraeos","555555555":"Ragnarok"}
ARN_SHINY_WEBHOOK_MAP_JSON=

# Optional persistent board message ID. If blank, Sentinel discovers an existing
# ARN board in the output channel or creates one and logs its message ID.
ARN_BOARD_MESSAGE_ID=

# Recent hidden-ingest messages replayed on startup to reconstruct board state.
ARN_REPLAY_LIMIT=100

# CAPTURED / DEFEATED entries stay visible for 3 minutes by default.
ARN_RESOLVED_TTL_SECONDS=180

# SIGNAL LOST entries clear faster by default.
ARN_LOST_TTL_SECONDS=60
ARN_CLEANUP_INTERVAL_SECONDS=15

# Keep true for the first live-ingest test. Events are parsed but no board is posted.
ARN_DRY_RUN=true
