FROM node:22.23.3-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NEXUS_GAME_ROLE=destiny
ENV VANGUARD_DATA_DIR=/data/vanguard

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src ./src
COPY config ./config
COPY native ./native
COPY config.example.json ./config.example.json

CMD ["node", "src/railway/vanguard-service.cjs"]
