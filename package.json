{
  "name": "khaos-nexus",
  "version": "0.32.0",
  "description": "Standalone local-first Nexus D&D desktop command center with Veyra AI and a dedicated Discord bot runtime.",
  "main": "main/entry-dnd-standalone.cjs",
  "author": "Khaos Krew",
  "license": "MIT",
  "private": true,
  "khaosRelease": {
    "displayVersion": "0.1.0-DND-TEST",
    "artifactVersion": "0.1.0-DND-TEST",
    "publicTag": "dnd-v0.1.0-test",
    "channel": "test",
    "updaterVersion": "0.32.0",
    "rollbackTag": "v0.31.0-B"
  },
  "scripts": {
    "start": "node scripts/materialize-assets.cjs && electron .",
    "test": "node --test",
    "check": "node scripts/check.cjs",
    "pack": "node scripts/materialize-assets.cjs && electron-builder --dir",
    "dist:win": "node scripts/materialize-assets.cjs && electron-builder --win --x64",
    "release:win": "node scripts/materialize-assets.cjs && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "electron-updater": "6.8.9",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.khaosnexus.dnd",
    "productName": "Nexus D&D",
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "output": "dist-dnd",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "bot/**/*",
      "renderer/**/*",
      "shared/**/*",
      "assets/**/*",
      "packages/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus D&D",
      "artifactName": "Nexus-DnD-Setup-0.1.0-TEST-${arch}.${ext}",
      "include": "assets/installer.nsh"
    },
    "portable": {
      "artifactName": "Nexus-DnD-Portable-0.1.0-TEST-${arch}.${ext}"
    }
  }
}
