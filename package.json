{
  "name": "khaos-nexus",
  "version": "0.1.0",
  "description": "Khaos Nexus Admin Control Center with backend-first game modules and Nexus Sentinal Discord consoles.",
  "main": "src/main.cjs",
  "author": "Khaos Krew",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "backend": "node src/backend/server.cjs",
    "sentinel": "node src/sentinel/bot.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.khaosnexus.admin",
    "productName": "Khaos Nexus",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "config.example.json", "package.json", "README.md", "REBUILD_SCOPE.md"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Khaos Nexus"
    }
  }
}
