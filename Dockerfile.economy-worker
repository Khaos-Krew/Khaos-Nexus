FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY src ./src
COPY config/ark/cluster-shop-catalog.json ./config/ark/cluster-shop-catalog.json
USER node
CMD ["node", "src/economy-worker/entry.cjs"]
