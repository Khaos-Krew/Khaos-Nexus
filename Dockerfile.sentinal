FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src ./src
COPY src/shared/brand-assets ./src/shared/brand-assets
COPY scripts ./scripts
COPY migrations ./migrations
COPY tests ./tests
COPY config ./config
COPY native ./native
COPY config.example.json ./config.example.json
COPY Dockerfile.sentinal Dockerfile.cephalon Dockerfile.ascended Dockerfile.sanctuary ./
COPY docs/ops/STAGE1_GAME_BOT_OPS.md ./docs/ops/STAGE1_GAME_BOT_OPS.md
COPY docs/ops/SANCTUARY_NEXUS_DISCORD.md ./docs/ops/SANCTUARY_NEXUS_DISCORD.md
COPY docs/ops/sanctuary-bot-runbook.md ./docs/ops/sanctuary-bot-runbook.md
COPY docs/ops/JOIN_TO_CREATE.md ./docs/ops/JOIN_TO_CREATE.md
COPY docs/ops/SENTINAL_ROLE_ORDER.md ./docs/ops/SENTINAL_ROLE_ORDER.md
COPY Dockerfile.craft ./Dockerfile.craft
COPY docs/ops/NEXUS_CRAFT.md ./docs/ops/NEXUS_CRAFT.md
COPY docs/architecture/MC_POINTS_OWNER_DECISIONS_2026-10-01.md ./docs/architecture/MC_POINTS_OWNER_DECISIONS_2026-10-01.md
COPY docs/architecture/ARK_NP_SHOP_REBUILD_PLAN_2026-10-02.md ./docs/architecture/ARK_NP_SHOP_REBUILD_PLAN_2026-10-02.md
COPY docs/ops/LEGACY_BANK_FLAT.md ./docs/ops/LEGACY_BANK_FLAT.md
COPY docs/WINDOWS_RELEASE_VALIDATION.md ./docs/WINDOWS_RELEASE_VALIDATION.md

RUN npm run check && npm test

CMD ["node", "-r", "./src/sentinel/arn-parser-runtime-patch.cjs", "-r", "./src/sentinel/arn-poll-reconcile-worker.cjs", "-r", "./src/sentinel/ark-ssh-probe-startup.cjs", "src/railway/sentinal-service.cjs"]