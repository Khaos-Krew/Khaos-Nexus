FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src ./src
COPY scripts ./scripts
COPY tests ./tests
COPY config ./config
COPY native ./native
COPY config.example.json ./config.example.json

RUN npm run check && npm test

CMD ["node", "-r", "./src/sentinel/arn-parser-runtime-patch.cjs", "-r", "./src/sentinel/ark-ssh-probe-startup.cjs", "src/railway/sentinal-service.cjs"]