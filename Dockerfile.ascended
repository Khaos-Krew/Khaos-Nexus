FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NEXUS_GAME_ROLE=ark_asa
ENV NEXUS_DATA_DIR=/app/data
ENV NEXUS_RCON_RAILWAY_ENV_FORBIDDEN=true
ENV NEXUS_RCON_SOURCE=discord_override_store
ENV ASCENDED_DISCORD_CATEGORY_ID=1516602943670059108

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src ./src
COPY config ./config
COPY native ./native
COPY config.example.json ./config.example.json

CMD ["node", "src/railway/ascended-service.cjs"]
