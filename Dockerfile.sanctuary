FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NEXUS_GAME_ROLE=diablo
ENV SANCTUARY_JTC_LOBBY_CHANNEL_ID=1541540961937526916

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src ./src
COPY config ./config
COPY native ./native
COPY config.example.json ./config.example.json

CMD ["node", "src/railway/sanctuary-service.cjs"]
