FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production
ENV NEXUS_GAME_ROLE=warframe
ENV NEXUS_BACKEND_HOST=127.0.0.1
ENV NEXUS_BACKEND_PORT=3210

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY src ./src
COPY config ./config
COPY native ./native
COPY config.example.json ./config.example.json

CMD ["node", "src/railway/cephalon-service.cjs"]
