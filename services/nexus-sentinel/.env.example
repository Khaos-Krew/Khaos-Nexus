# Discord identity
NEXUS_BOT_TOKEN=
NEXUS_BOT_APPLICATION_ID=
BOT_STATUS=online
BOT_ACTIVITY_TYPE=Watching
BOT_ACTIVITY_TEXT=Watching Khaos Nexus
PRESENCE_REFRESH_SECONDS=900

# Centralized GitHub -> Discord progress routing
# Install one organization-level GitHub webhook and point it at:
#   https://<sentinel-domain>/github/webhook
# Sentinel will verify the HMAC signature and route supported repository events
# into dedicated text channels under the configured Discord category.
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=Khaos-Krew
GITHUB_DISCORD_CATEGORY=Khaos Nexus
# Optional: pin routing to one Discord server. If omitted, Sentinel uses its first guild.
GITHUB_DISCORD_GUILD_ID=
# Comma-separated repo names or owner/repo values. Empty accepts any repo in GITHUB_ORG.
GITHUB_REPOSITORIES=

# Scheduled project reporting
# The report channel is automatically created under GITHUB_DISCORD_CATEGORY so
# daily reports sit beside the dedicated GitHub repository progress channels.
PROJECT_REPORT_CHANNEL=daily-project-reports
PROJECT_REPORT_TIMES=07:00,18:00
PROJECT_REPORT_TIMEZONE=America/Chicago
PROJECT_REPORT_LOOKBACK_HOURS=14
# Grace window lets a restarted Railway service catch a report shortly after the target minute.
PROJECT_REPORT_GRACE_MINUTES=10
# Optional GitHub token for higher API limits. Public Khaos-Krew repositories work without it.
GITHUB_REPORT_TOKEN=

# Discord Premium App Shop rank reconciliation
SHOP_RANK_SYNC_SECONDS=900

# Legacy website-era Supabase automation.
# Leave false unless the retired Edge Function backend has intentionally been restored.
ENABLE_LEGACY_EDGE_JOBS=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Legacy automation intervals (seconds)
WARFRAME_EMBED_REFRESH_SECONDS=300
SERVER_STATUS_REFRESH_SECONDS=300
PATCH_NOTES_CHECK_SECONDS=300
ROLE_SYNC_INTERVAL_SECONDS=900
WEBSITE_HEALTH_INTERVAL_SECONDS=300
COMMUNITY_RANK_ROLE_SYNC_SECONDS=900
